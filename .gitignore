# Python caches (scripts/ and conformance suites)
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# Build outputs
/.build/
/bin/
/dist/
# scripts/sealed's Terraform config and plugin cache (it also ignores itself)
/.cache/
/understudy

# Test and runtime artifacts
*.log
*.test
*.out
coverage.txt
*.snapshot
# rapid's failure dumps; turn a real counterexample into a named test case
**/testdata/rapid/
/.data/

# Terraform working state (conformance suites)
.terraform/
*.tfstate
*.tfstate.backup

# Local tickets, specs and archived documents (docs/agents/issue-tracker.md)
/.scratch/

# Editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
